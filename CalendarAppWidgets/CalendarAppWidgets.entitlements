<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.footsoregnu3115.calendarapp</string>
	</array>
	<!--
	Same Mac Catalyst quirk found on the main app target: EventKit's TCC
	registration under Catalyst needs this declared explicitly per-bundle,
	even for an embedded extension checking an already-granted status
	rather than requesting it itself.
	-->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
</dict>
</plist>
